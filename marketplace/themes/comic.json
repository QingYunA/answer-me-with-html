{
  "label": {
    "zh": "漫画",
    "zh-Hant": "漫畫",
    "en": "Comic",
    "ja": "コミック",
    "he": "קומיקס"
  },
  "version": "1.1.0",
  "author": "Answer me with HTML",
  "license": "MIT",
  "description": {
    "en": "Comic panels with black ink, hard shadows and a yellow marker under the title.",
    "zh": "漫画分格：黑色粗线、硬阴影，标题下一道黄色荧光笔。"
  },
  "font": "bangers",
  "tokens": {
    "common": {
      "--radius": "0px",
      "--bw": "3px",
      "--head-font": "\"Bangers\", \"Avenir Next Condensed\", Impact, \"Arial Narrow\", var(--font-sans)",
      "--shadow": "6px 6px 0 var(--line)",
      "--comic-yellow": "#ffe600",
      "--node-width": "3px",
      "--node-radius": "0px",
      "--node-shadow": "drop-shadow(3px 3px 0 var(--line))",
      "--edge-width": "2",
      "--note-width": "2px",
      "--note-radius": "0px",
      "--edge-color": "var(--line)",
      "--note-stroke": "var(--line)",
      "--cluster-stroke": "var(--line)",
      "--lifeline-color": "var(--line)"
    },
    "light": {
      "--bg": "#ffffff",
      "--paper": "#ffffff",
      "--ink": "#111111",
      "--ink-2": "#3d3d3d",
      "--ink-3": "#6b6b6b",
      "--line": "#111111",
      "--line-2": "#dedede",
      "--fill": "#f5f5f5",
      "--accent": "#0064a4",
      "--accent-bg": "#dff1fb",
      "--ok": "#1e7a3c",
      "--ok-bg": "#e0f3e5",
      "--err": "#c4122f",
      "--err-bg": "#fde3e7",
      "--warn": "#855400",
      "--warn-bg": "#fff3c7",
      "--head-bg": "#ffe600",
      "--head-fg": "#111111",
      "--comic-title-bg": "linear-gradient(transparent 58%, var(--comic-yellow) 58%, var(--comic-yellow) 92%, transparent 92%)",
      "--comic-title-fg": "var(--ink)",
      "--comic-title-pad": "0",
      "--hi-fill": "#ffe600",
      "--hi-stroke": "#111111",
      "--hi-text": "#111111",
      "--actor-fill": "#ffe600",
      "--actor-stroke": "#111111",
      "--actor-text": "#111111",
      "--note-fill": "#ffe600",
      "--edge-label": "#111111"
    },
    "dark": {
      "--bg": "#111114",
      "--paper": "#18181d",
      "--ink": "#f2f2f2",
      "--ink-2": "#c9c9c9",
      "--ink-3": "#959595",
      "--line": "#f2f2f2",
      "--line-2": "#36363f",
      "--fill": "#22222a",
      "--accent": "#5cc8f5",
      "--accent-bg": "#16334a",
      "--ok": "#7fd394",
      "--ok-bg": "#1b3424",
      "--err": "#ff8296",
      "--err-bg": "#45202a",
      "--warn": "#ffd24d",
      "--warn-bg": "#3b3014",
      "--head-bg": "#ffe600",
      "--head-fg": "#111111",
      "--comic-title-bg": "linear-gradient(var(--comic-yellow), var(--comic-yellow))",
      "--comic-title-fg": "#111111",
      "--comic-title-pad": "0 0.25em",
      "--hi-fill": "#ffe600",
      "--hi-stroke": "#f2f2f2",
      "--hi-text": "#111111",
      "--actor-fill": "#ffe600",
      "--actor-stroke": "#f2f2f2",
      "--actor-text": "#111111",
      "--note-fill": "#4d4200",
      "--edge-label": "#f2f2f2"
    }
  },
  "css": "& .am-head h1 { font-family: var(--head-font); font-weight: 800; font-size: calc(34px * var(--am-scale, 1)); letter-spacing: 0.01em; text-transform: uppercase; }\n& .am-panel-head h2 { font-family: var(--head-font); font-weight: 800; font-size: calc(16px * var(--am-scale, 1)); letter-spacing: 0.03em; text-transform: uppercase; }\n& .am-panel-id { font-family: var(--head-font); font-weight: 800; }\n@media (max-width: 760px) {\n  & .am-head h1 { font-size: calc(27px * var(--am-scale, 1)); }\n}\n& .am-head h1 {\n  display: inline; background: var(--comic-title-bg); color: var(--comic-title-fg); padding: var(--comic-title-pad);\n  -webkit-box-decoration-break: clone; box-decoration-break: clone;\n}"
}
